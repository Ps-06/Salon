{
  "expo": {
    "name": "Bhagyoday",
    "slug": "bhagyoday-mobile",
    "version": "1.0.0",
    "scheme": "bhagyoday",
    "icon": "./assets/Bhagyoday_Logo_BG.png",
    "splash": {
      "image": "./assets/Bhagyoday_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d1b3d"
    },
    "android": {
      "package": "com.killerp2542c.bhagyodaymobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Bhagyoday_Logo.png",
        "backgroundColor": "#2d1b3d"
      }
    },
    "ios": {
      "icon": "./assets/Bhagyoday_Logo_BG.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97c88a61-1238-4d5a-b2b1-5529707f0606"
      }
    }
  }
}
